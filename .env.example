# Modele de configuration. Ce fichier est public : n'y mets JAMAIS de vraie valeur.
#
# En local : copie ce fichier en ".env.local" (ignore par git), puis remplis-le.
# Sur Vercel : Settings > Environment Variables (voir les explications de la partie 3).

# Cle API Groq (obligatoire pour les questions libres du chatbot). Commence par gsk_
GROQ_API_KEY=

# Modele principal (facultatif, defaut : openai/gpt-oss-120b)
GROQ_MODEL=

# Modeles de secours, essayes dans l'ordre si le principal repond 400, 404, 429 ou 5xx (facultatif).
# Verifie qu'ils sont toujours listes sur console.groq.com (page Models) : ils changent avec le temps.
GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Questions libres du chatbot : fermees par defaut. Mettre true pour les rouvrir
# (et CHAT_FREE=true dans app.js). Sinon /api/chat repond 503 "disabled".
CHAT_FREE_ENABLED=false

# Domaines autorises a appeler /api/chat en plus du site lui-meme (facultatif)
ALLOWED_ORIGINS=
